     },
     "name": "CU-84 Registrar tacto en el partograma",
     "ownedElements": [
      {
       "_type": "UMLInclude",
       "_id": "FMBUML000451",
       "_parent": {
        "$ref": "FMBUML000067"
       },
       "source": {
