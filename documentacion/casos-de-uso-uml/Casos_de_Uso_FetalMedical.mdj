    {
     "_type": "UMLUseCase",
     "_id": "FMBUML000019",
     "_parent": {
      "$ref": "FMBUML000002"
     },
     "name": "CU-70 Registrar resultado de laboratorio",
     "ownedElements": [
      {
       "_type": "UMLInclude",
       "_id": "FMBUML000411",
       "_parent": {
        "$ref": "FMBUML000019"
       },
       "source": {
